# ============================================================
# AI Healthcare Platform — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Gemini AI ---
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Embedding model to use for pgvector RAG
# Supported: text-embedding-004
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Generative model to use for responses
GEMINI_GENERATIVE_MODEL=gemini-2.0-flash

# --- PostgreSQL + pgvector ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# For Docker Compose (local): postgresql+asyncpg://healthuser:healthpass@localhost:5432/healthdb
DATABASE_URL=

# Synchronous URL for Alembic migrations
DATABASE_URL_SYNC=

# --- JWT Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Application ---
APP_ENV=development
APP_NAME=HealthConnect India
FRONTEND_URL=http://localhost:5173

# --- File uploads ---
# Max upload size in bytes (default 20MB)
MAX_UPLOAD_SIZE_BYTES=20971520
# Allowed MIME types for policy documents
ALLOWED_DOC_MIME_TYPES=application/pdf,image/jpeg,image/png,image/tiff

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Integrations (mark UNAVAILABLE if not configured) ---
# NHA PMJAY Hospital API (requires NHA registration)
# https://hospitals.pmjay.gov.in
NHA_PMJAY_API_KEY=
NHA_PMJAY_API_BASE_URL=

# Notification/reminder provider (e.g., Firebase FCM, Twilio)
REMINDER_PROVIDER=none

# --- Logging ---
LOG_LEVEL=INFO
